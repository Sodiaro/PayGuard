NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true
# Comma-separated browser origins allowed to call the API. Leave empty to send no CORS headers.
CORS_ALLOWED_ORIGINS=

# Outcome of the simulated payment provider for every payment: SUCCEEDED, DECLINED or UNAVAILABLE.
PAYMENT_SIMULATOR_OUTCOME=SUCCEEDED
# Token-bucket limits per process; with N instances the effective limit is N times higher.
RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_PAYMENT_CREATES_PER_MINUTE=60
# Reverse proxies in front of the API (0 = none). Must match the deployment, or per-IP limits key on the proxy.
TRUST_PROXY_HOPS=0

# Credentials must match POSTGRES_* below; URL-encode special characters in the password.
DATABASE_URL=postgresql://payguard:change-me@localhost:5432/payguard
# Integration tests migrate and truncate this database; its name must end with _test.
TEST_DATABASE_URL=postgresql://payguard:change-me@localhost:5432/payguard_test

POSTGRES_USER=payguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payguard
POSTGRES_HOST_PORT=5432
API_HOST_PORT=3000
