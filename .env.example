# Required, no default: development, test or production. Production refuses the payment simulator.
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true
# Comma-separated browser origins allowed to call the API. Leave empty to send no CORS headers.
CORS_ALLOWED_ORIGINS=

# Required, no default. The simulator is the only provider and is refused when NODE_ENV=production.
PAYMENT_PROVIDER=simulator
# Outcome of the simulated payment provider for every payment: SUCCEEDED, DECLINED or UNAVAILABLE.
PAYMENT_SIMULATOR_OUTCOME=SUCCEEDED
# true: the simulator processes each submission but the answer times out, so outcomes are recovered by lookup.
PAYMENT_SIMULATOR_AMBIGUOUS_SUBMISSIONS=false

# Background processing of payment attempts (see README: Processing and recovery).
# Run the worker inside the API process; set false when running `npm run start:worker` separately.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_RUNS=10
OUTBOX_BACKOFF_MAX_SECONDS=300
RECONCILIATION_DELAY_SECONDS=60

# /health reports degraded when due jobs wait longer than this, or no worker heartbeat arrives within the timeout.
HEALTH_QUEUE_BACKLOG_SECONDS=120
HEALTH_WORKER_TIMEOUT_SECONDS=30

# Signs and verifies simulator webhooks (POST /v1/webhooks/simulator). Empty disables the endpoint.
# At least 32 visible ASCII characters, never a merchant API key; e.g. the output of `openssl rand -hex 32`.
SIMULATOR_WEBHOOK_SECRET=
# How far a webhook's signed timestamp may differ from this server's clock (30-900 seconds).
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Recorded as the actor of operator CLI actions; defaults to <os user>@<host>.
# PAYGUARD_OPERATOR=

# Token-bucket limits per process; with N instances the effective limit is N times higher.
RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_PAYMENT_CREATES_PER_MINUTE=60
# Reverse proxies allowed to set X-Forwarded-For: IPs, CIDR ranges or loopback/linklocal/uniquelocal.
# Empty: the socket address is the client. List only proxies, never 0.0.0.0/0.
TRUSTED_PROXIES=

# Database roles (see README: Database roles). Each connection uses its own role and password;
# the passwords must match PAYGUARD_*_PASSWORD below. URL-encode special characters.
# The API and worker: the runtime role, which can only do what the application needs.
DATABASE_URL=postgresql://payguard_app:change-me-app@localhost:5432/payguard
# The operator CLI (npm run admin): the operator role.
OPERATOR_DATABASE_URL=postgresql://payguard_cli:change-me-cli@localhost:5432/payguard
# Migrations (npm run db:migrate:*): the schema owner.
MIGRATION_DATABASE_URL=postgresql://payguard_owner:change-me-owner@localhost:5432/payguard

# Integration tests migrate and truncate this database; its name must end with _test, and all
# three must name the same database.
TEST_DATABASE_URL=postgresql://payguard_app:change-me-app@localhost:5432/payguard_test
TEST_OPERATOR_DATABASE_URL=postgresql://payguard_cli:change-me-cli@localhost:5432/payguard_test
TEST_MIGRATION_DATABASE_URL=postgresql://payguard_owner:change-me-owner@localhost:5432/payguard_test

# The Compose PostgreSQL container. POSTGRES_USER is the bootstrap superuser: it only provisions the
# roles below (docker/postgres/init/01-roles-and-databases.sh) and nothing connects as it afterwards.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=payguard
PAYGUARD_OWNER_PASSWORD=change-me-owner
PAYGUARD_APP_PASSWORD=change-me-app
PAYGUARD_CLI_PASSWORD=change-me-cli
POSTGRES_HOST_PORT=5432
API_HOST_PORT=3000
