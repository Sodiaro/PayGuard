generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7: the URL lives in prisma.config.ts; at runtime PrismaService connects via the pg adapter.
datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED

  @@map("merchant_status")
}

model Merchant {
  id        String         @id @default(uuid(7)) @db.Uuid
  // Operator-chosen handle; the unique constraint makes provisioning retries fail instead of duplicating.
  slug      String         @unique @db.VarChar(64)
  name      String         @db.VarChar(200)
  status    MerchantStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  apiKeys  MerchantApiKey[]
  payments Payment[]

  @@map("merchants")
}

model MerchantApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  prefix     String    @unique @db.VarChar(32)
  // SHA-256 of the secret part only; see src/auth/api-key.ts for why a fast hash is sufficient.
  secretHash Bytes     @map("secret_hash")
  label      String?   @db.VarChar(100)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  // Coarse by design (see src/auth/key-usage-tracker.ts): accurate to the tracking window, not per request.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Restrict: merchants are suspended, never deleted, so key history stays auditable.
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@map("merchant_api_keys")
}

// Allowed transitions live in src/payments/payment-lifecycle.ts.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_status")
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_attempt_status")
}

enum PaymentFailureCode {
  DECLINED
  PROVIDER_UNAVAILABLE

  @@map("payment_failure_code")
}

model Payment {
  id         String        @id @default(uuid(7)) @db.Uuid
  merchantId String        @map("merchant_id") @db.Uuid
  // Smallest currency unit (kobo, cents, yen...); BIGINT because INT caps at ~21M major units.
  amount     BigInt
  currency   String        @db.Char(3)
  status     PaymentStatus @default(PENDING)
  // Merchant's own reference (e.g. an order ID). Informational only: not unique, not used for idempotency.
  reference  String?       @db.VarChar(64)

  idempotencyKey     String @map("idempotency_key") @db.VarChar(255)
  // SHA-256 hex of the canonical request; see src/payments/idempotency.ts.
  requestFingerprint String @map("request_fingerprint") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant      Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  attempts      PaymentAttempt[]
  retryRequests PaymentRetryRequest[]
  outboxJobs    OutboxJob[]

  // The idempotency guarantee: one payment per (merchant, key), enforced by the database.
  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, createdAt])
  @@index([merchantId, reference])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid(7)) @db.Uuid
  paymentId         String               @map("payment_id") @db.Uuid
  attemptNumber     Int                  @map("attempt_number")
  provider          String               @db.VarChar(32)
  status            PaymentAttemptStatus @default(PENDING)
  providerReference String?              @map("provider_reference") @db.VarChar(100)
  failureCode       PaymentFailureCode?  @map("failure_code")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set before the provider is first contacted. Once set, the provider may hold an outcome for this
  // attempt, so it is only ever looked up, never blindly resubmitted.
  submittedAt       DateTime?            @map("submitted_at") @db.Timestamptz(3)
  // Null while the outcome is unknown; set when the attempt reaches a terminal status.
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(3)

  payment      Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  retryRequest PaymentRetryRequest?
  outboxJobs   OutboxJob[]

  @@unique([paymentId, attemptNumber])
  @@map("payment_attempts")
}

// Idempotency record for POST /v1/payments/:id/retry, separate from the creation key on payments.
model PaymentRetryRequest {
  id                 String   @id @default(uuid(7)) @db.Uuid
  merchantId         String   @map("merchant_id") @db.Uuid
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(255)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  paymentId          String   @map("payment_id") @db.Uuid
  attemptId          String   @unique @map("attempt_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([merchantId, idempotencyKey])
  @@index([paymentId])
  @@map("payment_retry_requests")
}

enum OutboxJobType {
  PROCESS_ATTEMPT
  RECONCILE_ATTEMPT
  APPLY_WEBHOOK_EVENT

  @@map("outbox_job_type")
}

enum OutboxJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  DEAD

  @@map("outbox_job_status")
}

// Sanitized reason a job was delayed or retried; raw provider errors are never stored.
enum OutboxErrorCategory {
  PROVIDER_TIMEOUT
  PROVIDER_ERROR
  PROVIDER_UNAVAILABLE
  OUTCOME_PROCESSING
  LEASE_EXPIRED
  INTERNAL_ERROR

  @@map("outbox_error_category")
}

model OutboxJob {
  id              String               @id @default(uuid(7)) @db.Uuid
  type            OutboxJobType
  paymentId       String               @map("payment_id") @db.Uuid
  attemptId       String               @map("attempt_id") @db.Uuid
  status          OutboxJobStatus      @default(QUEUED)
  // Number of times the job has been claimed, including claims lost to a crash.
  runCount        Int                  @default(0) @map("run_count")
  // Claims that took the job over from a worker whose lease expired.
  leaseRecoveries Int                  @default(0) @map("lease_recoveries")
  availableAt     DateTime             @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedBy        String?              @map("locked_by") @db.VarChar(128)
  leaseToken      String?              @map("lease_token") @db.Uuid
  lockedUntil     DateTime?            @map("locked_until") @db.Timestamptz(3)
  lastError       OutboxErrorCategory? @map("last_error")
  requestId       String?              @map("request_id") @db.VarChar(128)
  // Set only on APPLY_WEBHOOK_EVENT jobs: the provider event the job applies.
  webhookEventId  String?              @unique @map("webhook_event_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(3)

  payment      Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attempt      PaymentAttempt        @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  webhookEvent ProviderWebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)

  // One attempt job of each type per attempt, so re-enqueueing is a no-op: enforced by the partial
  // unique index outbox_jobs_attempt_id_type_key (attempt jobs only), created in the migration
  // because Prisma cannot express it. Webhook jobs are unique per event instead.
  @@index([attemptId])
  @@index([paymentId])
  @@map("outbox_jobs")
}

// One row per worker process, refreshed while it runs. Lets any instance tell whether background
// processing is alive and progressing.
model OutboxWorker {
  id                String    @id @db.VarChar(128)
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  heartbeatAt       DateTime  @default(now()) @map("heartbeat_at") @db.Timestamptz(3)
  lastJobFinishedAt DateTime? @map("last_job_finished_at") @db.Timestamptz(3)
  jobsFinished      Int       @default(0) @map("jobs_finished")
  stoppedAt         DateTime? @map("stopped_at") @db.Timestamptz(3)

  @@index([heartbeatAt])
  @@map("outbox_workers")
}

// Append-only record of operator actions. Database administrators can still alter it, so it
// provides accountability for normal operations, not tamper evidence.
model OperatorAuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actor      String   @db.VarChar(200)
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(128)
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("operator_audit_events")
}

enum ProviderWebhookEventStatus {
  RECEIVED
  PROCESSED

  @@map("provider_webhook_event_status")
}

// What processing concluded; see the README section on provider webhooks for the policy.
enum ProviderWebhookEventResult {
  APPLIED
  ALREADY_APPLIED
  NO_ACTION
  UNKNOWN_ATTEMPT
  OUTCOME_CONFLICT
  DATA_MISMATCH
  PAYLOAD_CONFLICT

  @@map("provider_webhook_event_result")
}

// Authenticated provider notifications, stored before they are acknowledged. Only validated fields
// are kept, never the raw body or signature. attempt_id is what the provider reported, so it has
// no foreign key: an event for an unknown attempt is recorded, not applied.
model ProviderWebhookEvent {
  id                    String                      @id @default(uuid(7)) @db.Uuid
  provider              String                      @db.VarChar(32)
  eventId               String                      @map("event_id") @db.VarChar(100)
  eventType             String                      @map("event_type") @db.VarChar(64)
  attemptId             String                      @map("attempt_id") @db.Uuid
  providerReference     String                      @map("provider_reference") @db.VarChar(100)
  amount                BigInt
  currency              String                      @db.Char(3)
  eventCreatedAt        DateTime                    @map("event_created_at") @db.Timestamptz(3)
  // Signed delivery timestamp of the first accepted delivery.
  deliveredAt           DateTime                    @map("delivered_at") @db.Timestamptz(3)
  // SHA-256 hex of the canonical event; see src/webhooks/provider-webhook.requests.ts.
  payloadHash           String                      @map("payload_hash") @db.Char(64)
  status                ProviderWebhookEventStatus  @default(RECEIVED)
  result                ProviderWebhookEventResult?
  receivedAt            DateTime                    @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt           DateTime?                   @map("processed_at") @db.Timestamptz(3)
  duplicateDeliveries   Int                         @default(0) @map("duplicate_deliveries")
  // Deliveries that reused this event ID with different content. They are rejected, never stored.
  conflictingDeliveries Int                         @default(0) @map("conflicting_deliveries")
  lastConflictAt        DateTime?                   @map("last_conflict_at") @db.Timestamptz(3)

  outboxJob OutboxJob?

  // Deduplication: a provider event is stored once, however often it is delivered.
  @@unique([provider, eventId])
  @@index([attemptId])
  @@index([receivedAt])
  @@map("provider_webhook_events")
}
