generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7: the URL lives in prisma.config.ts; at runtime PrismaService connects via the pg adapter.
datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED

  @@map("merchant_status")
}

model Merchant {
  id        String         @id @default(uuid(7)) @db.Uuid
  // Operator-chosen handle; the unique constraint makes provisioning retries fail instead of duplicating.
  slug      String         @unique @db.VarChar(64)
  name      String         @db.VarChar(200)
  status    MerchantStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  apiKeys  MerchantApiKey[]
  payments Payment[]

  @@map("merchants")
}

model MerchantApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  prefix     String    @unique @db.VarChar(32)
  // SHA-256 of the secret part only; see src/auth/api-key.ts for why a fast hash is sufficient.
  secretHash Bytes     @map("secret_hash")
  label      String?   @db.VarChar(100)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Restrict: merchants are suspended, never deleted, so key history stays auditable.
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@map("merchant_api_keys")
}

// Allowed transitions live in src/payments/payment-lifecycle.ts.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_status")
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_attempt_status")
}

enum PaymentFailureCode {
  DECLINED
  PROVIDER_UNAVAILABLE

  @@map("payment_failure_code")
}

model Payment {
  id         String        @id @default(uuid(7)) @db.Uuid
  merchantId String        @map("merchant_id") @db.Uuid
  // Smallest currency unit (kobo, cents, yen...); BIGINT because INT caps at ~21M major units.
  amount     BigInt
  currency   String        @db.Char(3)
  status     PaymentStatus @default(PENDING)
  // Merchant's own reference (e.g. an order ID). Informational only: not unique, not used for idempotency.
  reference  String?       @db.VarChar(64)

  idempotencyKey     String @map("idempotency_key") @db.VarChar(255)
  // SHA-256 hex of the canonical request; see src/payments/idempotency.ts.
  requestFingerprint String @map("request_fingerprint") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]

  // The idempotency guarantee: one payment per (merchant, key), enforced by the database.
  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, createdAt])
  @@index([merchantId, reference])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid(7)) @db.Uuid
  paymentId         String               @map("payment_id") @db.Uuid
  attemptNumber     Int                  @map("attempt_number")
  provider          String               @db.VarChar(32)
  status            PaymentAttemptStatus @default(PENDING)
  providerReference String?              @map("provider_reference") @db.VarChar(100)
  failureCode       PaymentFailureCode?  @map("failure_code")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  // Null while the outcome is unknown; set when the attempt reaches a terminal status.
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNumber])
  @@map("payment_attempts")
}
